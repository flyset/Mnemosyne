{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "mymcp_*": "deny",
    "mymcp_list_tools": "allow",
    "mymcp_memory_recall": "allow",
    "mymcp_memory_inspect": "allow",
    "mymcp_memory_list": "allow",
    "mymcp_memory_remember": "ask",
    "mymcp_memory_revise": "ask",
    "mymcp_memory_archive": "ask",
    "mymcp_memory_restore": "ask",
    "mymcp_memory_forget": "ask"
  },
  "mcp": {
    "mymcp": {
      "type": "remote",
      "url": "http://127.0.0.1:8000/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:./.opencode/secrets/mymcp-credential}"
      }
    }
  },
  "agent": {
    "mymcp": {
      "permission": {
        "mymcp_*": "deny",
        "mymcp_list_tools": "allow",
        "mymcp_memory_recall": "allow",
        "mymcp_memory_inspect": "allow",
        "mymcp_memory_list": "allow",
        "mymcp_memory_remember": "ask",
        "mymcp_memory_revise": "ask",
        "mymcp_memory_archive": "ask",
        "mymcp_memory_restore": "ask",
        "mymcp_memory_forget": "ask"
      }
    },
    "build": {
      "model": "opencode/deepseek-v4-flash-free",
      "variant": "high"
    },
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "explore": {
      "model": "opencode/deepseek-v4-flash-free",
      "variant": "high"
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "test": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    },
    "repo": {
      "model": "opencode/deepseek-v4-flash-free",
      "variant": "high"
    },
    "docs": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    }
  }
}
